# Copy this file to .env before running Docker Compose.
# Generate a private value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_PORT=8080

# Optional values for `docker compose --profile setup run --rm bootstrap-admin`.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
