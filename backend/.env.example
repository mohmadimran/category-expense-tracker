PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker
JWT_SECRET=

# Used only by `npm run bootstrap:admin`; remove these values after the initial setup.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Additional allowed frontend origins, comma-separated. The production Vercel
# origin https://category-expense-tracker.vercel.app is allowed by default.
CORS_ORIGINS=
# Set to 1 when deployed behind one trusted reverse proxy (for example, Render).
TRUST_PROXY=1
